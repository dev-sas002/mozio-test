# Copy to .env for local (non-Docker) runs. Real environment variables always
# win over the values in this file. docker compose supplies its own values.

DJANGO_SECRET_KEY="django-insecure-change-me"
DJANGO_DEBUG="true"
DJANGO_ALLOWED_HOSTS="127.0.0.1,localhost"
DJANGO_LOG_LEVEL="INFO"

POSTGRES_DB="django_test"
POSTGRES_USER="username"
POSTGRES_PASSWORD="password"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_CONN_MAX_AGE="60"

# API behaviour
API_PAGE_SIZE="10"
API_MAX_PAGE_SIZE="100"
# "true" keeps reads anonymous but requires an authenticated user for writes.
API_REQUIRE_AUTH="false"

# Only needed when GeoDjango cannot find libgeos_c / libgdal on its own
# (Homebrew, Postgres.app, conda, ...). Leave empty to use auto-detection.
GEOS_LIBRARY_PATH=""
GDAL_LIBRARY_PATH=""
